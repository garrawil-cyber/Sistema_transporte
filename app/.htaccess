# ============================================================
# Bloquear acceso directo vía HTTP (Apache 2.4)
# ============================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (compatibilidad con servidores antiguos)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>