# ============================================================
# PLANTILLA DE CONFIGURACIÓN
# Copia este archivo a .env y rellena los valores reales
# Comando: cp .env.example .env
# ============================================================

# Email (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_de_gmail
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=tu_correo@gmail.com
MAIL_FROM_NAME="Nombre de tu empresa"
MAIL_REPLY_TO=correo_respuesta@gmail.com

# Facturación
FACTURACION_RUC=20000000000
FACTURACION_RAZON_SOCIAL="Tu Empresa SAC"
FACTURACION_SOL_USER=20000000000MODDATOS
FACTURACION_SOL_PASS=moddatos
FACTURACION_AMBIENTE=beta
FACTURACION_MODO_SIMULACION=true

# Base de datos
DB_HOST=localhost
DB_NAME=sistema_transporte
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Aplicación
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Sistema_transporte/public/